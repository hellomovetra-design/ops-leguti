{
  "name": "jne-ops-insight",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node -e \"const fs=require('node:fs'),p=require('node:path');function walk(d){for(const e of fs.readdirSync(d,{withFileTypes:true})){const f=p.join(d,e.name);if(e.isDirectory())walk(f);else if(e.name==='route.ts'){const s=fs.readFileSync(f,'utf8'),n=s.replace(/(?<!APP_ORIGIN \\|\\| )\\b(?:req|request)\\.nextUrl\\.origin\\b/g,m=>'(process.env.APP_ORIGIN || '+m+')');if(n!==s)fs.writeFileSync(f,n);}}}walk('app/api');\"",
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "next lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-table": "^8.21.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "9.6.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^2.6.0",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "postcss": "8.5.32",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "0.35.5"
  }
}
